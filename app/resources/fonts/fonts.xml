<fonts>
    <!-- Rasterized digits of Roboto Black (Apache 2.0), generated by
         tools/genfont.py in BMFont format. Three sizes so the app can render
         the biggest count that fits: while resting the count is the ONLY
         element on screen, and a single digit fills ~82% of a FR255 face. -->
    <font id="BigCount290" filename="RobotoBlack_290.fnt" filter="0123456789" />
    <font id="BigCount185" filename="RobotoBlack_185.fnt" filter="0123456789" />
    <font id="BigCount125" filename="RobotoBlack_125.fnt" filter="0123456789" />
</fonts>
