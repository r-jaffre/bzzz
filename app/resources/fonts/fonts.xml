<fonts>
    <!-- Rasterized digits of Roboto Black (Apache 2.0), generated by
         tools/genfont.py in BMFont format. Three sizes so the app can render
         the biggest count that fits: a single digit uses BigCount215
         (~60%% of the screen height on a FR255). -->
    <font id="BigCount215" filename="RobotoBlack_215.fnt" filter="0123456789" />
    <font id="BigCount180" filename="RobotoBlack_180.fnt" filter="0123456789" />
    <font id="BigCount125" filename="RobotoBlack_125.fnt" filter="0123456789" />
</fonts>
